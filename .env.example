# Kopiér denne fil til .env og udfyld dine egne værdier.

# Sti til OCES3-certifikat (.cer, DER-format)
# Anbefalet placering: offline uden for projektmappen, f.eks. ~/.credentials/
CERT_FILE=/sti/til/dit/certifikat.cer

# Sti til tilhørende privat nøgle (.key eller .pem, ukrypteret PKCS8)
# Anbefalet placering: offline uden for projektmappen, f.eks. ~/.credentials/
KEY_FILE=/sti/til/din/private.key

# Udbydersystem-ID som er registreret hos STIL
UDBYDER_SYSTEM_ID=ABxxxxxx

# Standard-institutionsliste (kommasepareret)
# Bruges når ingen instnr angives på kommandolinjen.
# Kan udelades hvis man altid angiver instnr direkte.
INSTITUTIONS=101088,101155,101126

# STILs dataminimeringsfiltre til wsieksport.py (se README for detaljer).
# Alle er valgfrie — udelades de, bruges STILs egen standard (typisk: alt medtages).

# Filter 1: Inkludér CPR-numre i mellem/fuld/fuld-myndighed. Standard: false (udelades).
# INKLUDER_CPR=true

# Filter 2: Begræns til udvalgte klassetrin (kommasepareret). Gælder alle eksporttyper.
# Gyldige værdier: DT, 0-10, U1, U2, U3, U4, VU, Andet. Standard: alle klassetrin.
# KLASSETRIN=0,1,2,3

# Filter 3: Begræns til udvalgte aktørtyper (kommasepareret). Gælder alle eksporttyper.
# Gyldige værdier: elever, medarbejdere, eksterne, kontaktpersoner. Standard: alle aktørtyper.
# AKTOERTYPER=elever,medarbejdere

# Logniveau: DEBUG, INFO, WARNING eller ERROR (standard: INFO)
LOG_LEVEL=INFO

# Valgfri logfil — udelad for kun at logge til konsollen
# LOG_FILE=stil_webservice.log
