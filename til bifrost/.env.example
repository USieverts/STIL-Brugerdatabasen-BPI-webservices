# Kopiér denne fil til .env (i samme mappe som scriptet) og udfyld værdierne til serveren.
# .env indeholder stier til certifikat og nøgle — den må aldrig committes eller deles.

# Sti til OCES3-certifikat (.cer, DER-format)
# Læg gerne certifikat og nøgle uden for denne mappe, med adgang begrænset til kørselskontoen.
CERT_FILE=D:\secrets\stil\certifikat.cer

# Sti til tilhørende privat nøgle (.key eller .pem, ukrypteret PKCS8)
KEY_FILE=D:\secrets\stil\private.key

# Udbydersystem-ID som er registreret hos STIL
UDBYDER_SYSTEM_ID=ABxxxxxx

# Institutionsnumre der hentes (kommasepareret)
INSTITUTIONS=101088,101155,101126

# Mappen som XML-filerne gemmes i (oprettes hvis den ikke findes).
# Brug en absolut sti — en relativ sti tolkes ud fra denne mappe.
# Filerne hedder eksport_fuld-myndighed_<instnr>.xml og overskrives ved hver kørsel.
OUTPUT_DIR=D:\bifrost\indbakke

# STILs dataminimeringsfiltre (valgfrie — udelades de, bruges STILs egen standard)
# Filter 1: Inkludér CPR-numre. Standard: false (udelades).
# INKLUDER_CPR=true
# Filter 2: Begræns til udvalgte klassetrin (kommasepareret). Standard: alle.
# Gyldige værdier: DT, 0-10, U1, U2, U3, U4, VU, Andet
# KLASSETRIN=0,1,2,3
# Filter 3: Begræns til udvalgte aktørtyper (kommasepareret). Standard: alle.
# Gyldige værdier: elever, medarbejdere, eksterne, kontaktpersoner
# AKTOERTYPER=elever,medarbejdere

# Logniveau: DEBUG, INFO, WARNING eller ERROR (standard: INFO)
LOG_LEVEL=INFO

# Logfil (relativ sti tolkes ud fra denne mappe; standard: wsieksport.log).
# Roterer automatisk ved 1 MB, 5 filer gemmes.
# LOG_FILE=wsieksport.log
